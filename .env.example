# BMU Registry System - environment variables
# Copy to .env and fill in your own values. Never commit real secrets.

# SQLite database used by Prisma (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional one-time setup token. If empty, the seed script generates one and
# prints it once. Used to create the first system administrator.
BMU_BOOTSTRAP_TOKEN=""

# Path to ClamAV scanner on non-Windows hosts (Windows uses Microsoft Defender)
BMU_CLAMSCAN_PATH=""

# Public URL used to build invitation links inside emails.
APP_URL="http://localhost:3000"

# Gmail SMTP for invitation emails. Use a Google App Password, not your normal
# account password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="BMU Registry"


# Production PostgreSQL example (swap the Prisma datasource when ready):
# DATABASE_URL="postgresql://user:password@localhost:5432/bmu_registry"
