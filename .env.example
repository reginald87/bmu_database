# BMU Registry System - environment variables
# Copy to .env for local development, or set these in the cPanel Node.js app UI.
# Never commit real secrets.

# MySQL / MariaDB connection used by Prisma.
# Local example:  mysql://root:password@localhost:3306/bmu_registry
# cPanel example: mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_dbname?connection_limit=5
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL="mysql://bmu_user:bmu_password@localhost:3306/bmu_registry?connection_limit=5"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional one-time setup token. If empty, the seed script generates one and
# prints it once. Used to create the first system administrator.
# On cPanel, set this to a strong value before running the seed so you can read it
# from the dashboard, then remove it after the first administrator is created.
BMU_BOOTSTRAP_TOKEN=""

# Path to a ClamAV scanner on Linux hosts. cPanel shared hosting usually does not
# provide ClamAV. Set BMU_ALLOW_UNSCANNED_UPLOADS=true only for a fictional demo.
BMU_CLAMSCAN_PATH=""
BMU_ALLOW_UNSCANNED_UPLOADS="false"

# Public URL used to build invitation links inside emails.
# Production example for this deployment: https://bmuregistry.bmu.edu.ng
APP_URL="http://localhost:3000"

# Gmail SMTP for invitation emails. Use a Google App Password, not your normal
# account password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="BMU Registry"

# Optional SMTP overrides (Gmail defaults shown).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
